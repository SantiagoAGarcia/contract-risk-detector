# Copiar a .env y completar.

# --- LLM (ejemplo con Groq, capa gratuita) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_tu_clave_aqui

# --- Base de datos (valores por defecto de docker-compose.yml) ---
# Solo necesarios si se ejecuta la API o manage.py fuera de Docker.
DATABASE_URL=postgresql://app_user:app_dev@localhost:5432/contracts
ADMIN_DATABASE_URL=postgresql://admin:admin_dev@localhost:5432/contracts
APP_DB_PASSWORD=app_dev
